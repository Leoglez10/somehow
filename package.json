{
  "name": "somewhen-prototype",
  "version": "0.1.0",
  "description": "A social scheduling prototype for finding time with friends.",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node node_modules/vinext/dist/cli.js start",
    "test": "node node_modules/vinext/dist/cli.js build && node --test tests/rendered-html.test.mjs tests/supabase-security.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:start": "node node_modules/supabase/dist/supabase.js start",
    "db:reset": "node node_modules/supabase/dist/supabase.js db reset",
    "db:test": "node node_modules/supabase/dist/supabase.js db reset && node node_modules/supabase/dist/supabase.js db query --local --file supabase/tests/security.sql"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.4",
    "@supabase/supabase-js": "2.112.0",
    "lucide-react": "^0.468.0",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "supabase": "2.111.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
